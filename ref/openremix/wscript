#! /usr/bin/env python
# encoding: utf-8
# ref_openremix build script for Xash3D FWGS

import os

top = '.'

def options(opt):
	grp = opt.add_option_group('ref_openremix options')
	grp.add_option('--openremix-include', action='store', dest='OPENREMIX_INCLUDE', default=None,
		help='path to OpenRemix public/include directory containing remix/remix_c.h')

def configure(conf):
	# 1. Architecture Check: OpenRemix requires 64-bit AMD64 pointer size
	if conf.env.DEST_CPU != 'x86_64':
		conf.fatal('ref_openremix requires a 64-bit target CPU (x86_64/amd64). Configure with -8 or --64bits.')

	# 2. Platform Check: outside Windows, OpenRemix opens its own SDL3 window and the engine
	# takes it over, so the engine must be on the same SDL3
	if conf.env.DEST_OS != 'win32' and not conf.options.SDL3:
		conf.fatal('ref_openremix needs the engine built with SDL3 outside Windows. Configure with --use-sdl3.')
	if conf.env.DEST_OS != 'win32':
		# for the event filter that routes input to the OpenRemix overlay
		conf.check_cfg(package='sdl3', args='--cflags --libs', uselib_store='SDL3')

	# 3. Locate OpenRemix include path
	openremix_inc = conf.options.OPENREMIX_INCLUDE or os.environ.get('OPENREMIX_INCLUDE')
	candidates = [
		openremix_inc,
		# An OpenRemix checkout next to this repository:
		os.path.abspath(os.path.join(conf.path.abspath(), '../../../OpenRemix/public/include')),
		os.path.abspath(os.path.join(conf.path.abspath(), '../../OpenRemix/public/include')),
	]

	found_inc = None
	for cand in candidates:
		if cand and os.path.isfile(os.path.join(cand, 'remix', 'remix_c.h')):
			found_inc = os.path.abspath(cand)
			break

	if not found_inc:
		conf.fatal('Could not locate OpenRemix public/include directory containing remix/remix_c.h. Specify with --openremix-include=<path>')

	conf.env.OPENREMIX_INCLUDE = found_inc
	conf.msg('Checking for OpenRemix headers', found_inc)

def build(bld):
	# Dynamically collect all available C sources in ref/openremix/
	source = bld.path.ant_glob('*.c')

	# Include directories: local ref/openremix and OpenRemix public/include
	includes = ['.', bld.env.OPENREMIX_INCLUDE]

	# Build dependencies:
	# - engine_includes: provides engine headers (ref_api.h, com_model.h, etc.)
	# - sdk_includes: provides common, pm_shared, engine paths
	# - public: libpublic static library (mathlib, string helpers, matrix functions)
	# - werror: strict compilation flags
	# - yy_thunks: Windows CRT compatibility thunks
	# - USER32, GDI32: Win32 HWND presentation and window sizing
	# - DL: dlopen for libremix.so elsewhere
	# - M: math library
	libs = [
		'public',
		'engine_includes',
		'sdk_includes',
		'werror',
		'M'
	]
	if bld.env.DEST_OS == 'win32':
		libs += ['yy_thunks', 'USER32', 'GDI32']
	else:
		libs += ['DL', 'SDL3']

	bld.shlib(
		source       = source,
		target       = 'ref_openremix',
		includes     = includes,
		defines      = ['REF_DLL=1', 'REF_OPENREMIX=1'],
		features     = 'format',
		use          = libs,
		install_path = bld.env.LIBDIR
	)
